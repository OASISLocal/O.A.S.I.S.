{
  "ci": {
    "collect": {
      "staticDistDir": ".lh-site",
      "url": [
        "http://localhost/O.A.S.I.S./",
        "http://localhost/O.A.S.I.S./tools.html",
        "http://localhost/O.A.S.I.S./models.html",
        "http://localhost/O.A.S.I.S./pricing.html",
        "http://localhost/O.A.S.I.S./faq.html",
        "http://localhost/O.A.S.I.S./how-it-works.html",
        "http://localhost/O.A.S.I.S./security.html",
        "http://localhost/O.A.S.I.S./privacy.html",
        "http://localhost/O.A.S.I.S./requirements.html",
        "http://localhost/O.A.S.I.S./features.html",
        "http://localhost/O.A.S.I.S./comparison.html",
        "http://localhost/O.A.S.I.S./download.html",
        "http://localhost/O.A.S.I.S./changelog.html",
        "http://localhost/O.A.S.I.S./about.html",
        "http://localhost/O.A.S.I.S./glossary/",
        "http://localhost/O.A.S.I.S./blog/",
        "http://localhost/O.A.S.I.S./es/",
        "http://localhost/O.A.S.I.S./es/blog/",
        "http://localhost/O.A.S.I.S./es/glossary/"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "maxWaitForLoad": 45000
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "categories:performance": ["error", { "minScore": 0.9 }],
        "canonical": "error",
        "html-has-lang": "error",
        "html-lang-valid": "error",
        "crawlable-anchors": "error",
        "is-crawlable": "error",
        "meta-description": "error",
        "http-status-code": "error",
        "link-text": "warn",
        "image-alt": "error",
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "total-blocking-time": ["warn", { "maxNumericValue": 200 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
