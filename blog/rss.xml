---
layout: null
permalink: /blog/rss.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="{{ '/blog/feed.xsl' | relative_url }}"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:content="http://purl.org/rss/1.0/modules/content/">
  <channel>
    <title>O.A.S.I.S. Journal</title>
    <link>{{ '/blog/' | absolute_url }}</link>
    <description>{% if site.lang == 'es' %}Notas{% endif %}Release notes, deep dives and what we learn building a local-first AI assistant.</description>
    <language>en</language>
    <copyright>O.A.S.I.S. — independent local-first project</copyright>
    <atom:link href="{{ '/blog/rss.xml' | absolute_url }}" rel="self" type="application/rss+xml"/>
    <lastBuildDate>{% assign en = site.posts | where: "lang", "en" | where_exp: "p", "p.sitemap != false" %}{% if en.first %}{{ en.first.date | date_to_rfc822 }}{% else %}{{ site.time | date_to_rfc822 }}{% endif %}</lastBuildDate>
    <generator>Jekyll</generator>
{% assign en = site.posts | where: "lang", "en" | where_exp: "p", "p.sitemap != false" %}
{% for post in en limit:20 %}
    <item>
      <title>{{ post.title | xml_escape }}</title>
      <link>{{ post.url | absolute_url }}</link>
      <guid isPermaLink="true">{{ post.url | absolute_url }}</guid>
      <pubDate>{{ post.date | date_to_rfc822 }}</pubDate>
      <description>{{ post.excerpt | strip_html | strip_newlines | xml_escape }}</description>
      <content:encoded>{{ post.content | xml_escape }}</content:encoded>
    </item>
{% endfor %}
  </channel>
</rss>
