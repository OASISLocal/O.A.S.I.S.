{
  "ci": {
    "collect": {
      "staticDistDir": ".",
      "url": [
        "http://localhost/",
        "http://localhost/tools.html",
        "http://localhost/models.html",
        "http://localhost/pricing.html",
        "http://localhost/faq.html",
        "http://localhost/features.html",
        "http://localhost/requirements.html",
        "http://localhost/security.html",
        "http://localhost/privacy.html",
        "http://localhost/how-it-works.html",
        "http://localhost/blog/",
        "http://localhost/es/blog/"
      ],
      "numberOfRuns": 1,
      "settings": {
        "formFactor": "mobile",
        "screenEmulation": { "mobile": true, "width": 360, "height": 780, "deviceScaleFactor": 2.625, "disabled": false },
        "maxWaitForLoad": 45000,
        "skipAudits": ["canonical"]
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 0.9 }],
        "categories:performance": ["warn", { "minScore": 0.9 }],
        "viewport": "error",
        "target-size": "error"
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
